{
  "schema_version": 1,
  "diagram_type": "sequence",
  "meta": {
    "title": "Run lifecycle",
    "locale": "en",
    "quality_profile": "showcase",
    "viewBox": [
      1060,
      620
    ],
    "column_fit": "spread"
  },
  "participants": [
    {
      "id": "dashboard",
      "type": "frontend",
      "label": "Dashboard / CLI",
      "sublabel": "Run request"
    },
    {
      "id": "api",
      "type": "backend",
      "label": "FastAPI",
      "sublabel": "Run routes"
    },
    {
      "id": "sqlite",
      "type": "database",
      "label": "SQLite",
      "sublabel": "Run and task state"
    },
    {
      "id": "agent",
      "type": "backend",
      "label": "Device agent",
      "sublabel": "Per-device worker"
    },
    {
      "id": "runner",
      "type": "external",
      "label": "Maestro",
      "sublabel": "Flow execution"
    },
    {
      "id": "artifacts",
      "type": "external",
      "label": "Artifacts",
      "sublabel": "Per-attempt files"
    }
  ],
  "messages": [
    {
      "id": "submit",
      "from": "dashboard",
      "to": "api",
      "y": 180,
      "label": "POST /runs (flows or workspace ref)",
      "variant": "emphasis"
    },
    {
      "id": "create",
      "from": "api",
      "to": "sqlite",
      "y": 215,
      "label": "Create run and split/matrix tasks"
    },
    {
      "id": "claim",
      "from": "agent",
      "to": "sqlite",
      "y": 250,
      "label": "Claim eligible task; heartbeat"
    },
    {
      "id": "spec",
      "from": "sqlite",
      "to": "agent",
      "y": 285,
      "label": "Task, app, flow snapshot",
      "variant": "return"
    },
    {
      "id": "execute",
      "from": "agent",
      "to": "runner",
      "y": 320,
      "label": "Execute on assigned device",
      "variant": "emphasis"
    },
    {
      "id": "files",
      "from": "runner",
      "to": "artifacts",
      "y": 355,
      "label": "JUnit, logs, screenshots"
    },
    {
      "id": "outcome",
      "from": "runner",
      "to": "agent",
      "y": 390,
      "label": "Exit status and parsed results",
      "variant": "return"
    },
    {
      "id": "finish",
      "from": "agent",
      "to": "sqlite",
      "y": 425,
      "label": "Finish or requeue with backoff"
    },
    {
      "id": "observe",
      "from": "dashboard",
      "to": "api",
      "y": 460,
      "label": "GET run or subscribe to SSE"
    },
    {
      "id": "read",
      "from": "api",
      "to": "sqlite",
      "y": 495,
      "label": "Read run, tasks, events"
    },
    {
      "id": "response",
      "from": "api",
      "to": "dashboard",
      "y": 530,
      "label": "Status, JUnit and artifact links",
      "variant": "return"
    }
  ]
}
