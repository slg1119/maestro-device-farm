{
  "shots": [
    {
      "batch": "connected", "name": "devices.png", "path": "/devices", "ready": "text=emulator-5560",
      "callouts": [
        {"number": 1, "selector": "main h1"},
        {"number": 2, "selector": "text=emulator-5560"},
        {"number": 3, "selector": "text=Available", "nth": 2}
      ]
    },
    {
      "batch": "connected", "name": "apps.png", "path": "/apps", "ready": "text=com.android.settings",
      "callouts": [
        {"number": 1, "selector": "main h1"},
        {"number": 2, "selector": "button:has-text('Upload APK')"},
        {"number": 3, "selector": "text=com.android.settings"}
      ]
    },
    {
      "batch": "connected", "name": "workspaces.png", "path": "/workspaces", "ready": "h2:has-text('example-app')",
      "actions": [{"click": "button:has-text('Register')", "waitFor": "[role=dialog]"}],
      "callouts": [
        {"number": 1, "selector": "[role=dialog] h2"},
        {"number": 2, "selector": "[role=dialog] label", "nth": 1},
        {"number": 3, "selector": "[role=dialog] label", "nth": 2},
        {"number": 4, "selector": "[role=dialog] label", "nth": 3},
        {"number": 5, "selector": "[role=dialog] button:has-text('Register')"}
      ]
    },
    {
      "batch": "connected", "name": "workspace-open.png", "path": "/workspaces", "ready": "h2:has-text('example-app')",
      "actions": [{"click": "details summary:has-text('Files and Recent Commits')", "waitFor": "text=my-flow.yaml"}],
      "callouts": [
        {"number": 1, "selector": "h2:has-text('example-app')"},
        {"number": 2, "selector": "text=main"},
        {"number": 3, "selector": "details summary:has-text('Files and Recent Commits')"}
      ]
    },
    {
      "batch": "connected", "name": "new-run.png", "path": "/runs/new", "ready": "text=Run Summary",
      "callouts": [
        {"number": 1, "selector": "main select", "nth": 0},
        {"number": 2, "selector": "main select", "nth": 2},
        {"number": 3, "selector": "text=Run Summary"}
      ]
    },
    {
      "batch": "connected", "name": "new-run-matrix.png", "path": "/runs/new", "ready": "text=Run mode",
      "callouts": [
        {"number": 1, "selector": "label:has-text('Split Across Devices')"},
        {"number": 2, "selector": "label:has-text('Run All Flows on Every Device')"},
        {"number": 3, "selector": "legend:has-text('Run mode')"}
      ]
    },
    {
      "batch": "connected", "name": "new-run-manual.png", "path": "/runs/new", "ready": "text=Select Devices",
      "actions": [
        {"click": "button[role=radio]:has-text('Select Devices')", "waitFor": "input[aria-label*='emulator-5560']"},
        {"click": "input[aria-label*='emulator-5560']"}
      ],
      "callouts": [
        {"number": 1, "selector": "button[role=radio]:has-text('Select Devices')"},
        {"number": 2, "selector": "label:has(input[aria-label*='emulator-5560'])"},
        {"number": 3, "selector": "p[role=status]:has-text('emulator-5560')"}
      ]
    },
    {
      "batch": "connected", "name": "new-run-conditions.png", "path": "/runs/new", "ready": "text=Use Conditions",
      "actions": [
        {"click": "button[role=radio]:has-text('Use Conditions')"},
        {"click": "details summary:has-text('Model and Android version')"},
        {"scrollY": 200}
      ],
      "callouts": [
        {"number": 1, "selector": "button[role=radio]:has-text('Use Conditions')"},
        {"number": 2, "selector": "input[aria-label='Android API level (minimum)']"},
        {"number": 3, "selector": "p[role=status]:has-text('emulator-5560')"}
      ]
    },
    {
      "batch": "connected", "name": "new-run-tags.png", "path": "/runs/new", "ready": "textarea[aria-label='Explicit Flow Paths']",
      "actions": [{"scroll": "textarea[aria-label='Explicit Flow Paths']"}],
      "callouts": [
        {"number": 1, "selector": "input[aria-label='Include flows with any of these tags']"},
        {"number": 2, "selector": "input[aria-label='Exclude flows with these tags']"},
        {"number": 3, "selector": "textarea[aria-label='Explicit Flow Paths']"}
      ]
    },
    {
      "batch": "connected", "name": "runs.png", "path": "/runs", "ready": "main h1",
      "callouts": [
        {"number": 1, "selector": "main h1"},
        {"number": 2, "selector": "main input[placeholder]"},
        {"number": 3, "selector": "tr:has-text('Passed')"}
      ]
    },
    {
      "batch": "connected", "name": "run-detail.png", "path": "/runs/{failedRun}", "ready": "text=Artifacts",
      "callouts": [
        {"number": 1, "selector": "table tbody button[aria-pressed='true']"},
        {"number": 2, "selector": "text=Assertion is false:"},
        {"number": 3, "selector": "text=Artifacts"}
      ]
    },
    {
      "batch": "connected", "name": "run-junit.png", "path": "/runs/{passedRun}", "ready": "text=Download JUnit",
      "callouts": [
        {"number": 1, "selector": "text=Download JUnit"},
        {"number": 2, "selector": "text=Passed"},
        {"number": 3, "selector": "text=Flow results by device"}
      ]
    },
    {
      "batch": "connected", "name": "live-board.png", "path": "/live", "ready": "article[aria-label*='emulator-5560'] canvas", "livePixels": true,
      "callouts": [
        {"number": 1, "selector": "main h1"},
        {"number": 2, "selector": "text=emulator-5560"},
        {"number": 3, "selector": "article[aria-label*='emulator-5560'] :text('Available')"}
      ]
    },
    {
      "batch": "connected", "name": "editor-flow.png", "path": "/editor/{workspace}", "ready": "li[aria-label='my-flow.yaml']",
      "actions": [{"click": "li[aria-label='my-flow.yaml'] button", "waitFor": ".monaco-editor .view-line"}],
      "callouts": [
        {"number": 1, "selector": "aside[aria-label='File Explorer'] span:has-text('File Explorer')"},
        {"number": 2, "selector": "li[aria-label='my-flow.yaml']"},
        {"number": 3, "selector": "button[role=tab]:has-text('my-flow.yaml')"},
        {"number": 4, "selector": ".monaco-editor .view-line"}
      ]
    },
    {
      "batch": "connected", "name": "flow-editor.png", "path": "/editor/{workspace}", "ready": "li[aria-label='my-flow.yaml']",
      "actions": [
        {"click": "li[aria-label='my-flow.yaml'] button", "waitFor": ".monaco-editor .view-line"},
        {"focus": ".monaco-editor .view-line", "press": "ControlOrMeta+End"},
        {"type": "\n# A safe Settings example"},
        {"waitMs": 500}
      ],
      "callouts": [
        {"number": 1, "selector": "button:has-text('Validate')"},
        {"number": 2, "selector": "button[role=tab]:has-text('Problems')"},
        {"number": 3, "selector": "button:has-text('Commit…')"}
      ]
    },
    {
      "batch": "connected", "name": "editor-ai.png", "path": "/editor/{workspace}", "ready": "button[role=tab]:has-text('AI')",
      "actions": [
        {"click": "li[aria-label='my-flow.yaml'] button", "waitFor": ".monaco-editor .view-line"},
        {"click": "button[role=tab]:has-text('AI')", "waitFor": "text=Description"}
      ],
      "callouts": [
        {"number": 1, "selector": "text=Create a New Flow"},
        {"number": 2, "selector": "text=Description"},
        {"number": 3, "selector": "button:has-text('Generate')"}
      ]
    },
    {
      "batch": "connected", "name": "editor-screen.png", "path": "/editor/{workspace}", "ready": "button[role=tab]:has-text('Screen')", "demoAuthor": true,
      "actions": [
        {"click": "li[aria-label='my-flow.yaml'] button", "waitFor": ".monaco-editor .view-line"},
        {"click": "button[role=radio]:has-text('emulator-5560')"},
        {"click": "button:text-is('Reserve')", "waitFor": "button:text-is('Release')"},
        {"click": "button[role=tab]:has-text('Screen')", "waitFor": "canvas[aria-label='Live device screen']"},
        {"waitPixels": "canvas[aria-label='Live device screen']"},
        {"click": "section[aria-label*='emulator-5560'] button[aria-label='Home']"},
        {"waitFor": "section[aria-label*='emulator-5560'] span:has-text('Demo')"}
      ],
      "callouts": [
        {"number": 1, "selector": "button[role=tab]:has-text('Screen')"},
        {"number": 2, "selector": "canvas[aria-label='Live device screen']"},
        {"number": 3, "selector": "section[aria-label*='emulator-5560'] span:has-text('Controller')"}
      ],
      "cleanupActions": [
        {"click": "button[role=tab]:has-text('Run')"},
        {"clickIfPresent": "button:text-is('Release')"}
      ]
    },
    {
      "batch": "offline", "name": "overview.png", "path": "/", "ready": "main h1",
      "actions": [{"waitForReload": "text=Offline", "timeoutMs": 90000}],
      "callouts": [
        {"number": 1, "selector": "main h1"},
        {"number": 2, "selector": "text=Agent not responding"},
        {"number": 3, "selector": "text=Available Devices"}
      ]
    },
    {
      "batch": "offline", "name": "docker-overview.png", "path": "/", "ready": "main h1",
      "actions": [{"waitForReload": "text=Offline", "timeoutMs": 90000}],
      "callouts": [
        {"number": 1, "selector": "main h1"},
        {"number": 2, "selector": "text=Agent not responding"},
        {"number": 3, "selector": "text=Available Devices"}
      ]
    }
  ],
  "gifs": [
    {
      "batch": "gifs", "name": "hero.gif", "path": "/", "ready": "main h1", "seconds": 2,
      "callouts": [{"number": 1, "selector": "main h1"}],
      "actions": [
        {"waitMs": 1600},
        {"goto": "/runs/new", "waitFor": "main h1", "callouts": [{"number": 2, "selector": "main h1"}], "waitMs": 1800},
        {"goto": "/runs/{passedRun}", "waitFor": "text=Passed", "callouts": [{"number": 3, "selector": "text=Passed"}], "waitMs": 2000}
      ]
    },
    {
      "batch": "gifs", "name": "running-tests.gif", "path": "/runs/new", "ready": "button:has-text('Start Run')", "seconds": 3, "trimStart": 1.4,
      "actions": [
        {"fill": "textarea[aria-label='Explicit Flow Paths']", "value": "smoke.yaml"},
        {"click": "label:has-text('Run All Flows on Every Device')"},
        {"scrollY": -2000, "waitMs": 300},
        {"callouts": [{"number": 1, "selector": "button:has-text('Start Run')"}], "waitMs": 2600},
        {"click": "button:has-text('Start Run')", "waitFor": "text=Running", "waitMs": 1200},
        {"callouts": [{"number": 2, "selector": "main h1"}, {"number": 3, "selector": "text=Running"}]}
      ]
    }
  ]
}
